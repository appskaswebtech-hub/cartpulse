# Copy to .env and fill in. Never commit the real .env.

# Database (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/cart_cartpulse"

# Public URL of the app. The Shopify CLI sets this automatically in dev.
APP_URL="https://your-app-domain.com"

# Email delivery (Gmail app password, not your account password)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:you@example.com"

# Redis / queue (optional — not wired up yet)
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Support chat widget — talks to the separate support-dashboard app
SUPPORT_DASHBOARD_URL="http://localhost:3000"
SUPPORT_INCOMING_API_KEY=""
SUPPORT_APP_ID="cartpulse"
