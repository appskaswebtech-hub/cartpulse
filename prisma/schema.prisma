generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id @default(cuid())
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AbandonedCart {
  id            String             @id @default(cuid())
  shop          String
  cartToken     String             @unique(map: "AbandonedCart_cartToken_key")
  customerEmail String?
  customerPhone String?
  customerName  String?
  cartData      String             @db.LongText
  totalPrice    String
  currency      String             @default("INR")
  recoveredAt   DateTime?
  isRecovered   Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  notifications CartNotification[]
}

model CartNotification {
  id        String        @id @default(cuid())
  cartId    String
  type      String
  channel   String
  status    String        @default("pending")
  sentAt    DateTime?
  createdAt DateTime      @default(now())
  cart      AbandonedCart @relation(fields: [cartId], references: [id], map: "CartNotification_cartId_fkey")

  @@index([cartId], map: "CartNotification_cartId_fkey")
}

model JobQueue {
  id          String   @id @default(cuid())
  jobName     String
  payload     String   @db.LongText
  scheduledAt DateTime
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model MerchantSettings {
  id               String   @id @default(cuid())
  shop             String   @unique(map: "MerchantSettings_shop_key")
  discountPercent  Int      @default(10)
  discountExpiry   Int      @default(24)
  pushEnabled      Boolean  @default(false)
  whatsappEnabled  Boolean  @default(false)
  emailEnabled     Boolean  @default(false)
  whatsappApiKey   String?
  emailFromName    String?
  emailAppPassword String?
  emailFromAddress String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  shop      String
  endpoint  String   @unique(map: "PushSubscription_endpoint_key") @db.VarChar(500)
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model ShopPlan {
  id               Int       @id @default(autoincrement())
  shop             String    @unique(map: "ShopPlan_shop_key")
  plan             String    @default("free")
  subscriptionId   String?
  status           String    @default("active")
  trialEndsAt      DateTime?
  billingStartedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([shop], map: "ShopPlan_shop_idx")
}

model EmailUnsubscribe {
  id        String   @id @default(cuid())
  shop      String
  email     String
  createdAt DateTime @default(now())

  @@unique([shop, email], map: "EmailUnsubscribe_shop_email_key")
}

model SizeChart {
  id          String   @id @default(cuid())
  shop        String
  name        String
  status      String   @default("draft")
  unitSystem  String   @default("cm")
  template    String   @default("custom")
  columns     String   @db.LongText
  rows        String   @db.LongText
  description String?  @db.Text
  assignType  String   @default("all")
  assignValue String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop], map: "SizeChart_shop_idx")
}

model CartActivity {
  id               String    @id @default(cuid())
  shop             String
  cartToken        String
  variantId        String
  productId        String?
  title            String
  quantity         Int       @default(1)
  price            String
  imageUrl         String?   @db.Text
  currency         String    @default("INR")
  customerEmail    String?
  customerName     String?
  status           String    @default("pending")
  addedAt          DateTime  @default(now())
  remindedAt       DateTime?
  sentVia          String?
  scheduledSendAt  DateTime?
  scheduledSubject String?   @db.Text
  scheduledBody    String?   @db.LongText

  @@unique([shop, cartToken, variantId])
  @@index([shop, status])
}

model CartActivitySettings {
  id               String  @id @default(cuid())
  shop             String  @unique
  sendMode         String  @default("manual")
  delayMinutes     Int     @default(60)
  subject          String  @db.Text
  body             String  @db.LongText
  trackerInstalled Boolean @default(false)
}
