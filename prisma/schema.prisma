generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model AbandonedCart {
  id              String   @id @default(cuid())
  shop            String
  cartToken       String   @unique
  customerEmail   String?
  customerPhone   String?
  customerName    String?
  cartData        String
  totalPrice      String
  currency        String   @default("INR")
  recoveredAt     DateTime?
  isRecovered     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  notifications   CartNotification[]
}

model CartNotification {
  id            String   @id @default(cuid())
  cartId        String
  type          String
  channel       String
  status        String   @default("pending")
  sentAt        DateTime?
  createdAt     DateTime @default(now())

  cart          AbandonedCart @relation(fields: [cartId], references: [id])
}

model MerchantSettings {
  id              String  @id @default(cuid())
  shop            String  @unique
  discountPercent Int     @default(10)
  discountExpiry  Int     @default(24)
  pushEnabled     Boolean @default(true)
  whatsappEnabled Boolean @default(false)
  emailEnabled    Boolean @default(true)
  whatsappApiKey  String?
  emailFromName   String?
  emailFromAddress String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  shop      String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}